# Dependencies
node_modules/

# Local Python venv/cache (not used; ignore if leftover on disk)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Next.js
.next/
out/
.vercel/

# Build / tooling
*.tsbuildinfo
.turbo/

# Test & coverage
coverage/

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

